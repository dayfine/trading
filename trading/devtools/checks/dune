; Codebase-wide structural checks. Run as part of `dune runtest`.
; Each check is a shell script that fails fast with a clear message.
; Path exceptions are declared in linter_exceptions.conf.
;
; Shell scripts source trading/devtools/checks/_check_lib.sh for the
; shared repo_root / trading_dir / die helpers. Rules that run those
; scripts must declare _check_lib.sh as a dep so dune sandboxes it
; alongside the script; the script's `. "$(dirname "$0")/_check_lib.sh"`
; then finds it at the sandboxed location.
;
; Cache-invalidation deps: every rule that walks .ml/.mli source files at
; runtime (via find or Sys.readdir) must declare (glob_files_rec ...) so
; dune invalidates the rule's cache key when source content changes.
; Without these deps, `dune runtest` returns a cached PASS on a clean tree
; even after a new violation is introduced — the bug that caused incident
; PR #919 (linter cache hid violations; CI on a fresh checkout caught them).
;
; Scripts that use repo_root() to read files outside the dune workspace
; (e.g. .claude/agents/*.md, dev/status/*.md) still need explicit deps
; for cache invalidation — dune cannot infer cross-boundary reads.

; Architecture layer boundary: analysis/ must not import trading/trading/
; Scans dune files under analysis/ for forbidden cross-layer deps.

(rule
 (alias runtest)
 (deps
  _check_lib.sh
  (glob_files_rec %{workspace_root}/analysis/dune))
 (action
  (run sh %{dep:arch_layer_test.sh} %{dep:linter_exceptions.conf})))

; File length: 300-line soft limit, 500-line declared-large limit (11% cap).
; Scans lib/*.ml files (raw line count) AND lib/*.mli files (signature line
; count -- comment blocks + blank lines stripped; see linter_file_length.sh
; header for the raw-vs-signature rationale, H-MLI-FILE-LENGTH-BLIND-SPOT).
; Both globs are required deps: without the *.mli glob, a new .mli-only
; violation would not invalidate this rule's cache key (H-CHECK-CACHE-BLIND
; -- see PR #943 / dune-linter-deps entry in dev/status/harness.md).

(rule
 (alias runtest)
 (deps
  _check_lib.sh
  (glob_files_rec %{workspace_root}/*.ml)
  (glob_files_rec %{workspace_root}/*.mli))
 (action
  (run sh %{dep:linter_file_length.sh})))

; Fixture-driven self-test for linter_file_length.sh's .mli signature-line
; counting (H-MLI-FILE-LENGTH-BLIND-SPOT). Builds its own private fixture
; "trading dirs" under mktemp -d with crafted .mli files, so it never reads
; the real workspace tree -- no (glob_files_rec ...) dep needed beyond the
; linter script itself. See linter_file_length_test.sh's header for the
; four fixtures (raw>300/sig<=300 PASS, sig>300 FAIL, nested-comment
; depth-counter PASS, @large-module marker parity).

(rule
 (alias runtest)
 (deps _check_lib.sh linter_file_length.sh)
 (action
  (run sh %{dep:linter_file_length_test.sh})))

; .mli coverage: every lib/*.ml must have a matching .mli
; Scans lib/*.ml and lib/*.mli files across the workspace.

(rule
 (alias runtest)
 (deps
  _check_lib.sh
  (glob_files_rec %{workspace_root}/*.ml)
  (glob_files_rec %{workspace_root}/*.mli))
 (action
  (run sh %{dep:linter_mli_coverage.sh} %{dep:linter_exceptions.conf})))

; Dangling odoc-reference check (WARN-only, non-gating -- see the script's
; own header for the full design rationale): a `[Module._identifier]` or
; `{!Module._identifier}` doc-comment reference to a private, underscore-
; prefixed symbol that no longer exists anywhere in the tree under that
; name (renamed, moved, or deleted with the doc comment never updated).
; Filed by qc-behavioral on PR #2542 (finding B1, harness_gap:
; LINTER_CANDIDATE); see dev/status/cleanup.md `linter_candidate` entry.
; Always exits 0 (the pre-existing backlog of 11 real dangling references
; on main is tracked as its own cleanup.md item, not gated here) unless
; ODOC_DANGLING_REF_CHECK_STRICT=1 is set in the environment -- not done by
; this rule, so CI always sees the non-gating default.

(rule
 (alias runtest)
 (deps
  _check_lib.sh
  (glob_files_rec %{workspace_root}/*.ml)
  (glob_files_rec %{workspace_root}/*.mli))
 (action
  (run sh %{dep:odoc_dangling_ref_check.sh})))

; Fixture-driven self-test for odoc_dangling_ref_check.sh: builds private
; throwaway "trading dirs" under mktemp -d, so it never depends on the real
; repo's current population of dangling/live doc references. See
; odoc_dangling_ref_check_test.sh's header for the 5 fixtures (clean tree,
; PR #2542's exact regression shape, binding-site regex robustness for
; `let rec` / glued `let[@attr]`, a fails-closed vacuity-mutant backstop,
; and the STRICT-mode toggle).

(rule
 (alias runtest)
 (deps _check_lib.sh odoc_dangling_ref_check.sh)
 (action
  (run sh %{dep:odoc_dangling_ref_check_test.sh})))

; Magic numbers: numeric literals must be routed through config records
; Scans all lib/*.ml files across the workspace via Sys.readdir at runtime.
; OCaml exe (devtools/magic_numbers_linter/), not a shell script: the former
; shell version (linter_magic_numbers.sh, removed) forked ~8-10 subprocesses
; PER SOURCE LINE for comment-depth tracking, quote counting, and candidate
; extraction -- ~460k-575k process spawns across ~57k lines, ~35 minutes
; under Docker-on-macOS. This does the identical per-line scan in one
; process, no forking: ~35min -> ~1s. See
; devtools/magic_numbers_linter/lib/magic_numbers_linter_lib.mli for the
; full exempt-surface rule enumeration and known cosmetic divergences, and
; devtools/magic_numbers_linter/test/ for the pinned regression suite.

(rule
 (alias runtest)
 (deps
  (glob_files_rec %{workspace_root}/*.ml)
  %{dep:linter_exceptions.conf})
 (action
  (run
   %{exe:../magic_numbers_linter/magic_numbers_linter.exe}
   %{workspace_root}
   %{dep:linter_exceptions.conf})))

