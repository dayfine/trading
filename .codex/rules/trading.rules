# Project-local equivalent of .claude/settings.local.json's Bash allowlist.
#
# These rules apply only when Codex is run in this repository. Codex's sandbox
# and workspace-write boundaries remain separate controls.

# Version control and GitHub operations.
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["jj"], decision="allow")
prefix_rule(pattern=["jst"], decision="allow")
prefix_rule(pattern=["gh"], decision="allow")

# Project development container operations.
prefix_rule(pattern=["docker"], decision="allow")

# Read-only shell utilities used by project workflows.
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["egrep"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["tr"], decision="allow")
prefix_rule(pattern=["comm"], decision="allow")
prefix_rule(pattern=["join"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["perl"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["xxd"], decision="allow")
prefix_rule(pattern=["od"], decision="allow")
prefix_rule(pattern=["basename"], decision="allow")
prefix_rule(pattern=["dirname"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["df"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["pgrep"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["printf"], decision="allow")
prefix_rule(pattern=["true"], decision="allow")
prefix_rule(pattern=["test"], decision="allow")
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["touch"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")

# The Claude policy permits only these cleanup locations.
prefix_rule(pattern=["rm", "-rf", ".claude/worktrees/"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "/tmp/"], decision="allow")
prefix_rule(pattern=["rm", "-f", "/tmp/"], decision="allow")

# Checked-in project scripts and temporary review/controller scripts.
prefix_rule(pattern=["sh", "dev/scripts/"], decision="allow")
prefix_rule(pattern=["bash", "dev/scripts/"], decision="allow")
prefix_rule(pattern=["sh", "/tmp/"], decision="allow")
prefix_rule(pattern=["nohup", "sh", "/tmp/"], decision="allow")
