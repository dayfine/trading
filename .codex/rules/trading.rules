# Trading repository command approvals, loaded at startup in a trusted project.
# An allow rule permits execution outside the sandbox. Task authorization,
# worktree isolation and container scheduling still apply.
prefix_rule(pattern=["jj"], decision="forbidden", justification="Use plain git in your own worktree; jj belongs to the dispatcher.", match=["jj status"])
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden", justification="Leave merging to the dispatcher or human.", match=["gh pr merge 2786 --admin"])
# Flags can appear anywhere; do not automatically allow any review invocation.
prefix_rule(pattern=["gh", "pr", "review"], decision="prompt", match=["gh pr review 2786 --approve", "gh pr review --comment 2786"])
prefix_rule(pattern=["gh", "api"], decision="prompt", justification="Check the HTTP method and endpoint before granting access.")
prefix_rule(pattern=["gh", "pr", ["view", "diff", "checks", "list", "create"]], decision="allow", match=["gh pr view 2786"], not_match=["gh pr merge 2786", "gh pr review 2786 --approve"])
prefix_rule(pattern=["gh", "issue", ["view", "list", "create", "comment", "edit"]], decision="allow", match=["gh issue edit 2394 --repo dayfine/trading --remove-label ready-for-agent --add-label needs-info"], not_match=["gh issue delete 2394", "gh issue transfer 2394 other/repo"])
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["gh", "run", ["view", "list"]], decision="allow")
# Exec allows arbitrary code in this container: use only for authorized tasks
# against your own checkout. It is not restricted to Dune by this prefix.
prefix_rule(pattern=["docker", "exec", "trading-1-dev"], decision="allow", match=["docker exec trading-1-dev ps"], not_match=["docker exec other-container ps", "docker stop trading-1-dev"])
prefix_rule(pattern=["docker", ["inspect", "stats", "ps"]], decision="allow")
prefix_rule(pattern=["docker", ["stop", "restart", "rm", "kill", "system"]], decision="forbidden", justification="Do not interrupt or remove shared containers or data.")
prefix_rule(pattern=["git", ["status", "diff", "log", "show", "rev-parse", "ls-files", "fetch", "switch", "add", "commit"]], decision="allow")
prefix_rule(pattern=["git", "worktree", ["add", "list"]], decision="allow")
# Cleanup requires checking the exact target; directory tokens are not globs.
prefix_rule(pattern=["git", "worktree", "remove"], decision="prompt")
prefix_rule(pattern=["rm"], decision="prompt")
# Interpreters and editing utilities keep normal approval handling.
prefix_rule(pattern=[["ls", "cat", "head", "tail", "wc", "rg", "grep", "diff", "file", "stat", "pwd", "date", "df", "du", "pgrep", "ps", "echo", "true"]], decision="allow")
# Match a complete script path, not a directory prefix.
prefix_rule(pattern=["sh", "dev/scripts/pr_gate_status.sh"], decision="allow", match=["sh dev/scripts/pr_gate_status.sh 2786"], not_match=["sh /tmp/anything.sh"])

# Explicit prompt wins over any saved personal raw-push allow.
prefix_rule(pattern=["git", "push"], decision="prompt", match=["git push origin main", "git push -u origin codex/x-y", "git push origin HEAD:main"], not_match=["sh dev/scripts/codex_push.sh"])
# The helper validates its branch and rejects all arguments. Review its code
# with this rule: a script-path allow does not pin the script contents.
prefix_rule(pattern=["sh", "dev/scripts/codex_push.sh"], decision="allow", match=["sh dev/scripts/codex_push.sh"], not_match=["git push origin main", "sh /tmp/codex_push.sh"])
