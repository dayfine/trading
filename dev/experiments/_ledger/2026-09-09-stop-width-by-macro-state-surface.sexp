((date 2026-09-09) (slug stop-width-by-macro-state-surface)
 (hypothesis
  "Sizing the FALLBACK initial stop by the five-state breadth read (initial_stop_buffer_by_macro_state, #2718, default-off axis; plan dev/plans/stop-width-by-macro-state-2026-09-06.md) beats the record's flat 4% on the 26y top-3000 PIT-2000 record convention. Candidate map = Bullish/Recovering 0.9167 (12%), Neutral 0.96 (8%) [a2: 0.94 = 10%], Deteriorating/Bearish 1.0 (4%). Motivation: the 09-04 yearly review's per-state P&L (Deteriorating entries -$604k, Recovering +$627k) and the 09-05 width surface (12% won at 26y on the pre-#2672 basis).")
 (base_scenario
  "stop-width-by-state-2026-09-08: rec26y-new record spec + breadth_direction ON, salts 0-2, TWO warehouses. Phase 1 on _v7mark (build e7dde095a, sweep-item3): null a0 = the record cell digit-for-digit at all three salts. Phase 2 on _v10dedup (rename twins dropped, MEL quarantined; warehouse-dedup-2026-09-08/rebuild4.sh; build 969637974, sweep-item3v10): null a0 vs map a1 paired per salt, gated by validator_diff -check V6 = 0 on every cell (#2735).")
 (window_id top3000-2000-2026-record-26y-3salt) (baseline_label record-flat-4pct-null)
 (variants
  (((label null-a0-v10dedup-s0) (config_hash map-empty-breadth-on)
    (aggregate (((mean_sharpe 0.4453) (mean_calmar 0.1629) (mean_return_pct 382.74) (mean_max_drawdown_pct 37.60)))))
   ((label map-a1-neutral8-v10dedup-s0) (config_hash map-12-8-4)
    (aggregate (((mean_sharpe 0.3994) (mean_calmar 0.1265) (mean_return_pct 281.66) (mean_max_drawdown_pct 40.99)))))
   ((label null-a0-v10dedup-s1) (config_hash map-empty-breadth-on)
    (aggregate (((mean_sharpe 0.4272) (mean_calmar 0.1676) (mean_return_pct 311.75) (mean_max_drawdown_pct 32.75)))))
   ((label map-a1-neutral8-v10dedup-s1) (config_hash map-12-8-4)
