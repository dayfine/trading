;; shorts-phase-b-2026-10-09 v1: = v0-26 + the two #3218 short-ticket flags. Only the header, name, description and
;; the last two overrides differ from v0-26.sexp.
;; LAUNCHES AFTER #3218 MERGES. The two field names below are the ones PROPOSED in issue #3218 ("e.g."); confirm them
;; against the merged weinstein_strategy_config.mli before launch and, if they differ, amend this file in a
;; pre-launch commit (a Log line in the README) -- launch.sh refuses to start lane B unless both names are in the
;; run tree.
((name "v1-26")
 (description "short-only book, v1 = v0 + cancel short tickets off-Bearish + 4-week short ticket rest, 26y, pit-v12")
 (period ((start_date 2000-01-01) (end_date 2026-06-26)))
 (universe_path "pit-v12/composition/top-3000-1999.sexp")
 (universe_schedule (
  (1999-05-31 "pit-v12/composition/top-3000-1999.sexp")
  (2000-05-31 "pit-v12/composition/top-3000-2000.sexp")
  (2001-05-31 "pit-v12/composition/top-3000-2001.sexp")
  (2002-05-31 "pit-v12/composition/top-3000-2002.sexp")
  (2003-05-31 "pit-v12/composition/top-3000-2003.sexp")
  (2004-05-31 "pit-v12/composition/top-3000-2004.sexp")
  (2005-05-31 "pit-v12/composition/top-3000-2005.sexp")
  (2006-05-31 "pit-v12/composition/top-3000-2006.sexp")
  (2007-05-31 "pit-v12/composition/top-3000-2007.sexp")
  (2008-05-31 "pit-v12/composition/top-3000-2008.sexp")
  (2009-05-31 "pit-v12/composition/top-3000-2009.sexp")
  (2010-05-31 "pit-v12/composition/top-3000-2010.sexp")
  (2011-05-31 "pit-v12/composition/top-3000-2011.sexp")
  (2012-05-31 "pit-v12/composition/top-3000-2012.sexp")
  (2013-05-31 "pit-v12/composition/top-3000-2013.sexp")
  (2014-05-31 "pit-v12/composition/top-3000-2014.sexp")
  (2015-05-31 "pit-v12/composition/top-3000-2015.sexp")
  (2016-05-31 "pit-v12/composition/top-3000-2016.sexp")
  (2017-05-31 "pit-v12/composition/top-3000-2017.sexp")
  (2018-05-31 "pit-v12/composition/top-3000-2018.sexp")
  (2019-05-31 "pit-v12/composition/top-3000-2019.sexp")
  (2020-05-31 "pit-v12/composition/top-3000-2020.sexp")
  (2021-05-31 "pit-v12/composition/top-3000-2021.sexp")
  (2022-05-31 "pit-v12/composition/top-3000-2022.sexp")
  (2023-05-31 "pit-v12/composition/top-3000-2023.sexp")
  (2024-05-31 "pit-v12/composition/top-3000-2024.sexp")
  (2025-05-31 "pit-v12/composition/top-3000-2025.sexp")
  ))
 (universe_size 3000)
 (config_overrides
  (
   ((enable_sim_entry_stoplimit true))
   ((sim_entry_trigger_at_suggested true))
   ((sim_entry_stoplimit_fresh_bar_only true))
   ((sim_stop_exit_fill_on_trigger_bar true))
   ((stop_anchor_at_entry_base true))
   ((entry_extension_max_pct 2.0))
   ((reject_declining_ma_long_entry true))
   ((enable_short_side true))
   ((neutral_blocks_shorts true))
   ((enable_slow_grind_short_gate false))
   ((short_min_price 17.0))
   ((short_min_price_on_order_price true))
   ((short_borrow_min_dollar_adv 1000000.0))
   ((margin_config ((enabled true))))
   ((margin_config ((maintenance_margin_pct 0.30))))
   ((margin_config
     ((short_borrow_rate_tiers
       (((price_below 5.0) (value 1.00)) ((price_below 17.0) (value 0.25)))))))
   ((margin_config ((short_maintenance_finra true))))
   ((portfolio_config ((max_position_pct_long 0.14))))
   ((portfolio_config ((max_long_exposure_pct 0.70))))
   ((portfolio_config ((min_cash_pct 0.30))))
   ((enable_laggard_rotation true))
   ((laggard_rotation_config ((hysteresis_weeks 2))))
   ((liquidity_config ((min_entry_dollar_adv 1000000.0))))
   ((liquidity_config ((min_hold_dollar_adv 500000.0))))
   ((stale_exit_after_days (5)))
   ((macro_config ((breadth_direction ((enabled true))))))
   ((require_structural_stop true))
   ((stops_config ((support_floor_anchor_scope Nearest))))
   ((stops_config ((tightened_can_ratchet true))))
   ((max_one_share_class_per_issuer true))
   ((share_class_gate_covers_shorts true))
   ((screening_config ((max_buy_candidates 0))))
   ((screening_config ((max_short_candidates 20))))
   ((portfolio_config ((max_short_exposure_pct 0.60))))
   ((portfolio_config ((max_short_notional_fraction 0.60))))
   ((portfolio_config ((max_position_pct_short 0.10))))
   ((split_dividend_guard true))
   ((cash_yield (Series "macro/tbill_3m_dtb3.csv")))
   ((cash_yield_fee_bp 10.0))
   ((dividend_crediting true))
   ((short_cancel_on_non_bearish true))          ; V1 (#3218, name as proposed): cancel resting short tickets the first week the macro screen is not Bearish
   ((short_entry_order_max_rest_weeks (4)))      ; V1 (#3218, name as proposed): short tickets rest at most 4 weeks (longs keep entry_order_max_rest_weeks 52; inert here, longs off)
  ))
 (expected ((total_return_pct ((min -99.0) (max 90000.0))) (total_trades ((min 1) (max 90000)))
   (win_rate ((min 0.0) (max 100.0))) (sharpe_ratio ((min -5.0) (max 5.0)))
   (max_drawdown_pct ((min 0.0) (max 100.0))) (avg_holding_days ((min 0.0) (max 10000.0)))
   (sortino_ratio_annualized ((min -5.0) (max 10.0))) (calmar_ratio ((min -5.0) (max 5.0)))
   (ulcer_index ((min 0.0) (max 100.0))) (open_positions_value ((min -1.0e12) (max 1.0e12))))))
