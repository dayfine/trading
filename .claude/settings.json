{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/scripts/sweep_stale_worktrees.sh --threshold-percent 85 --stale-hours 24"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/scripts/cleanup_merged_worktrees.sh"
          }
        ]
      }
    ]
  }
}
