{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/scripts/sweep_stale_worktrees.sh --threshold-percent 85 --stale-hours 24"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/dev/scripts/session_brief.sh\" brief",
            "timeout": 60,
            "statusMessage": "Loading session brief"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/scripts/cleanup_merged_worktrees.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/dev/scripts/session_brief.sh\" precompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
